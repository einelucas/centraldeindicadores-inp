# Nunca versione o arquivo .env real. Copie este arquivo:
#   cp .env.example .env          (Linux/macOS/Git Bash)
#   Copy-Item .env.example .env   (Windows PowerShell)

# production | test | development
APP_ENV=development

# URL assíncrona usada pela aplicação (asyncpg). Formato:
#   postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=

# URL usada pelo Alembic para rodar migrations. Opcional — se vazia, usa
# DATABASE_URL. Útil para apontar migrations para uma conexão direta
# (equivalente ao DIRECT_URL do Prisma) sem trocar a URL da aplicação.
MIGRATION_DATABASE_URL=

# Trava de segurança: migrations do Alembic só rodam quando APP_ENV é "test"
# ou "development" E esta variável é exatamente "true". Nunca defina como
# true apontando para um banco de produção.
ALLOW_TEST_DB_MIGRATIONS=false

# Origens permitidas por CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# --- Keycloak / OIDC ---
# URL do issuer do realm, ex.: https://sso.empresa/realms/central-indicadores
KEYCLOAK_ISSUER=
# Audience esperada no access token (client da API no Keycloak).
KEYCLOAK_AUDIENCE=
# URL do JWKS. Se vazia, é descoberta via {KEYCLOAK_ISSUER}/.well-known/openid-configuration.
KEYCLOAK_JWKS_URL=
# Caminho (dot-notation) do claim de roles/grupos no token, se/quando a fonte
# de verdade de perfis migrar do banco local para claims do Keycloak.
KEYCLOAK_ROLE_CLAIM=realm_access.roles
# Algoritmos de assinatura aceitos, separados por vírgula. Nunca incluir "none".
KEYCLOAK_ALLOWED_ALGORITHMS=RS256
# Tempo (segundos) de cache das chaves JWKS antes de re-buscar.
JWKS_CACHE_TTL_SECONDS=3600

# --- Autenticação de desenvolvimento (bypass controlado) ---
# Só tem efeito quando true E APP_ENV != production. Desativado por padrão.
# Quando ativo, aceita tokens especiais "dev-viewer" / "dev-analyst" /
# "dev-admin" no header Authorization: Bearer, resolvendo/criando um usuário
# local correspondente — a matriz de permissões continua sendo aplicada
# normalmente (o bypass troca só "quem é você", nunca "o que você pode fazer").
DEV_AUTH_ENABLED=false
DEV_AUTH_USER_EMAIL=dev@example.com
DEV_AUTH_USER_ROLE=ADMIN

LOG_LEVEL=INFO

# Tamanho de lote de importação (equivalente a IMPORT_BATCH_SIZE do Next.js).
IMPORT_BATCH_SIZE=500
# Limite rígido de registros aceitos em um único lote (proteção de payload).
MAX_IMPORT_RECORDS_PER_BATCH=5000
# Paginação.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Habilita a criação de dados de teste pelo script de seed mesmo quando
# APP_ENV=production (dupla trava de segurança — nunca habilite em produção).
SEED_TEST_DATA=false
