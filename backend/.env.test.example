# Configuração EXCLUSIVA da suíte de testes (pytest). Nunca versione o
# arquivo real `.env.test`. Copie:
#   cp .env.test.example .env.test          (Linux/macOS/Git Bash)
#   Copy-Item .env.test.example .env.test   (Windows PowerShell)
#
# REGRA OBRIGATÓRIA: DATABASE_URL aqui DEVE apontar para um banco de dados
# FISICAMENTE SEPARADO do usado em `backend/.env` (o do servidor de
# desenvolvimento). A suíte de testes executa `TRUNCATE` em todas as tabelas
# após cada teste (ver `tests/conftest.py`) — se apontar para o mesmo banco
# do `.env`, TODOS OS DADOS REAIS SÃO APAGADOS a cada execução dos testes.
# Isso já aconteceu neste projeto — ver docs/backend-migration-decisions.md.
#
# `tests/conftest.py` também se recusa a truncar qualquer banco cujo nome não
# termine em "_test", como segunda trava de segurança.

APP_ENV=test
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco_test
MIGRATION_DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco_test
ALLOW_TEST_DB_MIGRATIONS=true
CORS_ORIGINS=http://localhost:3000
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWKS_URL=
KEYCLOAK_ROLE_CLAIM=realm_access.roles
DEV_AUTH_ENABLED=true
LOG_LEVEL=INFO
